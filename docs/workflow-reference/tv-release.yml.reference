# INACTIVE REFERENCE: outside .github/workflows and not configured.
# This release uses local signing. Do not enable/configure this reference
# without a separate decision; active CI never receives signing secrets.
name: TV signed release candidate
on:
  workflow_dispatch:
    inputs:
      release_commit:
        description: Exact reviewed 40-character integration, fusion, or main commit
        required: true
        type: string
      version_name:
        description: Reviewed version name
        default: 0.4.0-preview.1
        required: true
        type: string
      build_number:
        description: Base Android code; ABI adds x10 plus 1/2/4
        default: '20324'
        required: true
        type: string
      tag:
        description: Existing exact tag; required only when creating a draft release
        default: ''
        required: false
        type: string
      create_draft_release:
        description: Create a GitHub draft prerelease after verification (never auto-publish)
        default: false
        type: boolean
permissions:
  contents: read
concurrency:
  group: tv-signed-release
  cancel-in-progress: false
jobs:
  signed-apks:
    environment: kazumi-tv-release
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    env:
      RELEASE_COMMIT: ${{ inputs.release_commit }}
      VERSION_NAME: ${{ inputs.version_name }}
      BUILD_NUMBER: ${{ inputs.build_number }}
      TV_APP_ID: ${{ vars.TV_RELEASE_APPLICATION_ID }}
      TV_CERT_SHA256: ${{ vars.TV_RELEASE_CERT_SHA256 }}
      TV_RELEASE_SETUP: ${{ vars.TV_RELEASE_SETUP }}
    steps:
      - name: Validate explicit configuration
        run: |
          [[ "$RELEASE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
          [[ "$VERSION_NAME" =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]]
          [[ "$BUILD_NUMBER" =~ ^[0-9]+$ ]] && (( BUILD_NUMBER >= 20324 && BUILD_NUMBER < 210000000 ))
          [[ "$TV_APP_ID" =~ ^com\.znbsf\.kazumi\.[a-z][a-z0-9.]*$ ]]
          [[ "$TV_APP_ID" != com.znbsf.kazumi.compose.tv ]]
          [[ "$TV_APP_ID" != *test* && "$TV_APP_ID" != *candidate* ]]
          [[ "$TV_CERT_SHA256" =~ ^[0-9a-f]{64}$ ]]
          [[ "$TV_RELEASE_SETUP" == reviewed-appid-and-signing-v1 ]]
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ inputs.release_commit }}
          fetch-depth: 0
      - name: Require the exact reviewed source commit
        run: |
          test "$(git rev-parse HEAD)" = "$RELEASE_COMMIT"
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with: {distribution: temurin, java-version: '21'}
      - run: sdkmanager 'platforms;android-36' 'build-tools;36.0.0' 'ndk;28.2.13676358'
      - uses: subosito/flutter-action@44ac965b96f18d999802d4b807e3256d5a3f9fa1 # v2.16.0
        with:
          channel: stable
          flutter-version: '3.47.3'
          cache: true
      - name: Verify exact Flutter revision
        run: |
          flutter --version --machine > "$RUNNER_TEMP/flutter-sdk.json"
          python -c "import json,os,pathlib; d=json.loads((pathlib.Path(os.environ['RUNNER_TEMP'])/'flutter-sdk.json').read_text()); assert d['frameworkRevision']=='e8113bf45620cbeb8aff64947ee4c93e16adb4cf' and d['frameworkVersion']=='3.47.3'"
      - run: flutter pub get --enforce-lockfile
      - run: flutter analyze --no-fatal-infos --fatal-warnings
      - run: flutter test --concurrency=2
      - name: Materialize approved signing file only on this ephemeral runner
        env:
          TV_KEYSTORE_BASE64: ${{ secrets.TV_KEYSTORE_BASE64 }}
        run: |
          umask 077
          printf '%s' "$TV_KEYSTORE_BASE64" | base64 --decode > "$RUNNER_TEMP/kazumi-tv-release.jks"
          test -s "$RUNNER_TEMP/kazumi-tv-release.jks"
      - name: Build ARMv7, ARM64 and x86_64 release artifacts
        env:
          TV_KEYSTORE_PATH: ${{ runner.temp }}/kazumi-tv-release.jks
          TV_KEYSTORE_PASSWORD: ${{ secrets.TV_KEYSTORE_PASSWORD }}
          TV_KEY_ALIAS: ${{ secrets.TV_KEY_ALIAS }}
          TV_KEY_PASSWORD: ${{ secrets.TV_KEY_PASSWORD }}
        run: >-
          flutter build apk --release --pub --flavor tv --split-per-abi
          --target-platform android-arm,android-arm64,android-x64
          --android-project-arg=kazumiTv=true
          --android-project-arg=kazumiTvSigned=true
          --android-project-arg=kazumiTvApplicationId=$TV_APP_ID
          --android-project-arg=kazumiTvLabel=KazumiTV
          --build-name=$VERSION_NAME --build-number=$BUILD_NUMBER
          --dart-define=KAZUMI_TV_PERF=false --dart-define=KAZUMI_TV_FIXED_SURFACES=true
      - name: Lockfile must remain unchanged after plugin regeneration
        run: git diff --exit-code -- pubspec.lock
      - name: Verify signed packages and produce checksums
        run: |
          mkdir -p build/tv-release
          for ABI in armeabi-v7a arm64-v8a x86_64; do
            APK="build/app/outputs/flutter-apk/app-$ABI-tv-release.apk"
            python tools/verify_tv_artifact.py "$APK" \
              --aapt "$ANDROID_HOME/build-tools/36.0.0/aapt" \
              --apksigner "$ANDROID_HOME/build-tools/36.0.0/apksigner" \
              --application-id "$TV_APP_ID" --abi "$ABI" --build-number "$BUILD_NUMBER" \
              --version-name "$VERSION_NAME" --source-sha "$RELEASE_COMMIT" \
              --certificate-sha256 "$TV_CERT_SHA256" --output "build/tv-release/$ABI.json"
            cp "$APK" "build/tv-release/KazumiTV-$VERSION_NAME-$ABI.apk"
          done
          cp LICENSE THIRD_PARTY_NOTICES.md build/tv-release/
          git archive --format=zip --output=build/tv-release/corresponding-source.zip "$RELEASE_COMMIT"
          (cd build/tv-release && sha256sum *.apk *.json corresponding-source.zip > SHA256SUMS.txt)
      - name: Remove runner signing file
        if: always()
        run: rm -f -- "$RUNNER_TEMP/kazumi-tv-release.jks"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: tv-signed-${{ inputs.release_commit }}
          if-no-files-found: error
          retention-days: 30
          path: build/tv-release/*
  draft:
    if: ${{ inputs.create_draft_release }}
    needs: signed-apks
    environment: kazumi-tv-release
    runs-on: ubuntu-24.04
    permissions:
      contents: write
    env:
      RELEASE_COMMIT: ${{ inputs.release_commit }}
      RELEASE_TAG: ${{ inputs.tag }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ inputs.release_commit }}
          fetch-depth: 0
      - name: Require preserved main ancestry and an existing exact tag
        run: |
          [[ "$RELEASE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
          [[ "$RELEASE_TAG" =~ ^tv-fusion-v[0-9A-Za-z.+-]+$ ]]
          test "$(git rev-parse HEAD)" = "$RELEASE_COMMIT"
          git merge-base --is-ancestor "$RELEASE_COMMIT" origin/main
          test "$(git rev-parse "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_COMMIT"
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: tv-signed-${{ inputs.release_commit }}
          path: release-artifacts
      - name: Create a draft only; a reviewed maintainer publishes separately
        env:
          GH_TOKEN: ${{ github.token }}
        run: >-
          gh release create "$RELEASE_TAG" --verify-tag --draft --prerelease
          --title "$RELEASE_TAG" --notes-file docs/RELEASE-TV-FUSION.md release-artifacts/*
